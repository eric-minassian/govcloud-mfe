{
  "name": "govcloud-mfe",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@govcloud-mfe/web --filter=@govcloud-mfe/frontend-api",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check . && turbo boundaries && pnpm run check:ownership",
    "format": "biome check --write .",
    "check:ownership": "pnpm --filter @govcloud-mfe/ownership-check run check",
    "release": "pnpm --filter @govcloud-mfe/release-cli run cli"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
