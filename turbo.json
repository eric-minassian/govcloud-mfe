{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["RELEASE_VERSION"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "target/release/frontend-api"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "boundaries": {
    "tags": {
      "module": {
        "dependencies": {
          "deny": ["module", "app"]
        }
      },
      "platform": {
        "dependencies": {
          "deny": ["module", "app"]
        }
      }
    }
  }
}
